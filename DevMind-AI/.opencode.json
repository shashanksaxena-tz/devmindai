{
  "$schema": "https://opencode.ai/schema/config.json",
  "data": {
    "directory": ".opencode"
  },
  "providers": {
    "gemini": {
      "disabled": false
    },
    "anthropic": {
      "disabled": false
    },
    "openai": {
      "disabled": false
    },
    "copilot": {
      "disabled": false
    },
    "mistral": {
      "disabled": false
    }
  },
  "agents": {
    "coder": {
      "model": "gemini/gemini-2.0-flash",
      "maxTokens": 8000
    },
    "task": {
      "model": "gemini/gemini-2.0-flash",
      "maxTokens": 4000
    },
    "title": {
      "model": "gemini/gemini-2.0-flash",
      "maxTokens": 100
    }
  },
  "shell": {
    "path": "/bin/bash",
    "args": ["-l"]
  },
  "autoCompact": true,
  "tools": {
    "edit": true,
    "bash": true,
    "read": true,
    "glob": true,
    "grep": true,
    "webfetch": true
  }
}
