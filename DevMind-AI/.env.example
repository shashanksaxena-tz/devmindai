# ============================================
# DevMind AI Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# See docs/cli/CONFIGURATION.md for details

# ============================================
# LLM PROVIDERS (at least one required)
# ============================================

# Google Gemini - RECOMMENDED (free tier available)
# Get key at: https://aistudio.google.com
# Free tier: 60 requests/minute
GOOGLE_API_KEY=

# Anthropic Claude - For complex reasoning tasks
# Get key at: https://console.anthropic.com
# Pricing: ~$3/M input, $15/M output tokens
ANTHROPIC_API_KEY=

# OpenAI - Optional fallback
# Get key at: https://platform.openai.com
OPENAI_API_KEY=

# ============================================
# GITHUB INTEGRATION (optional)
# ============================================
# Required for: devmind generate-pr, devmind pr-review

# Personal access token (simple setup)
# Create at: github.com/settings/tokens
# Scopes needed: repo, read:user
GITHUB_TOKEN=

# GitHub App (for automated PR reviews)
# Create at: github.com/settings/apps
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_PATH=./config/github-app.pem
GITHUB_WEBHOOK_SECRET=

# ============================================
# INFRASTRUCTURE (for API server mode)
# ============================================
# Not needed for CLI-only usage

# PostgreSQL - Data persistence
# Format: postgresql+asyncpg://user:pass@host:port/database
DATABASE_URL=postgresql+asyncpg://devmind:devmind@localhost:5432/devmind

# Redis - Caching and job queue
# Format: redis://[user:pass@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Qdrant - Vector search (optional)
# Format: http://host:port
QDRANT_URL=http://localhost:6333

# ============================================
# SECURITY
# ============================================

# Secret key for JWT tokens and encryption
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-at-least-32-characters-long

# JWT configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# APPLICATION SETTINGS
# ============================================

# Application metadata
APP_NAME=DevMind AI
APP_ENV=development

# Debug mode (set to false in production)
DEBUG=true

# API prefix
API_V1_PREFIX=/api/v1
